# Database Credentials
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=project_db
MYSQL_USER=user
MYSQL_PASSWORD=password

# JWT / Security Secrets (For Spring Boot)
JWT_SECRET=a_very_long_random_string_for_security_purposes
INTERNAL_API_KEY=my-local-dev-key

# Docker Configuration
DOCKER_REGISTRY_USER=your_dockerhub_username

# Database configuration
DB_USERNAME=username
DB_PASSWORD=password
DB_NAME=name_db

# Auth0 Configuration
AUTH0_DOMAIN=your_auth0_domain
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_REDIRECT_URI=your_redirect_uri
AUTH0_AUDIENCE=your_audience